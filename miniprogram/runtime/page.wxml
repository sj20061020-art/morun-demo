<view class="app-frame">
  <view class="topbar" wx:if="{{route !== 'splash'}}"><view class="brand" data-route="home" bindtap="go"><text class="seal">墨
润</text><text>墨润心源</text></view><text class="tiny">笔墨润心</text></view>
  <view wx:if="{{route === 'splash'}}" class="splash"><image src="/assets/splash-cover.jpg" class="splash-image" mode="aspectFill"/><button class="primary splash-button" data-action="enter" bindtap="act">进入疗愈空间</button><text class="tiny">青少年书画美育情绪辅助 Demo</text></view>
  <view wx:elif="{{route === 'write' || route === 'paint'}}" class="studio">
    <view class="row"><text class="title">{{title}}</text><button wx:if="{{route === 'write'}}" size="mini" data-action="music" bindtap="act">{{musicPlaying ? '暂停音乐' : '播放音乐'}}</button></view>
    <button size="mini" class="reference-entry" data-action="art-reference" bindtap="act">{{route === 'write' ? '书法鉴赏与参考' : '国画鉴赏与参考'}}</button>
    <text class="studio-guide">{{route === 'write' ? guide : '随心画，无对错，笔墨即心情'}}</text>
    <view wx:if="{{route === 'write'}}" class="row"><picker range="{{grids}}" value="{{gridIndex}}" bindchange="gridChange"><view class="pick">{{grids[gridIndex]}} ▾</view></picker><button size="mini" data-action="scroll" bindtap="act">{{scrollMode ? '切换为书写' : '切换为滚动'}}</button></view>
    <scroll-view class="canvas-scroll {{route === 'paint' ? 'paint-scroll' : ''}}" style="{{route === 'paint' && canvasSide ? 'width:' + canvasSide + 'px;height:' + canvasHeight + 'px;margin:auto' : canvasSide ? 'width:' + canvasSide + 'px;margin:auto' : ''}}" scroll-y="{{route === 'write' && scrollMode}}"><canvas id="artCanvas" type="2d" class="art-canvas" style="height:{{canvasHeight || 360}}px" bindtouchstart="touchStart" bindtouchmove="touchMove" bindtouchend="touchEnd" bindtouchcancel="touchEnd"/></scroll-view>
    <text wx:if="{{route === 'write'}}" class="tiny">{{scrollMode ? '现在可上下滚动纸面，切回书写再落笔。' : '长幅书写：需要移动纸面时，切换为滚动。'}}</text>
    <view class="tools"><picker range="{{brushes}}" value="{{brushIndex}}" bindchange="brushChange"><view class="pick">{{brushes[brushIndex]}} ▾</view></picker><picker range="{{colors}}" value="{{colorIndex}}" bindchange="colorChange"><view class="pick">{{colors[colorIndex]}} ▾</view></picker></view>
    <view class="size-row"><text class="tiny">笔触大小 {{size}}</text><slider min="3" max="30" value="{{size}}" activeColor="#53675B" block-size="18" bindchanging="sizeChange" bindchange="sizeChange"/></view>
    <view wx:if="{{route === 'paint'}}" class="tools"><button wx:for="{{materials}}" wx:key="*this" size="mini" data-action="material" data-id="{{item}}" bindtap="act">{{item}}</button></view>
    <view class="tools"><button size="mini" data-action="undo" bindtap="act">撤销</button><button wx:if="{{route === 'paint'}}" size="mini" data-action="redo" bindtap="act">恢复</button><button size="mini" data-action="clear" bindtap="act">清空</button><button size="mini" data-action="paper-crop" bindtap="act">裁切纸张</button><button wx:if="{{route === 'write'}}" size="mini" data-action="stamp" bindtap="act">加盖印章</button><button wx:else size="mini" class="{{eraser ? 'primary' : ''}}" data-action="eraser" bindtap="act">{{eraser ? '正在擦除' : '橡皮擦'}}</button><button size="mini" class="primary" data-action="art-save" bindtap="act">保存</button></view>
  </view>
  <view wx:elif="{{route === 'chat'}}" class="chat-page">
    <view class="row"><text class="title">AI 情绪陪伴</text><button size="mini" data-action="chat-new" bindtap="act">新会话</button></view>
    <view class="notice danger">⚠ AI仅美育情绪陪伴，不做心理诊断，出现强烈痛苦请寻求可信任成年人或专业老师支持。
</view>
    <scroll-view scroll-y class="chat-log" scroll-into-view="{{chatBottom}}"><view wx:for="{{messages}}" wx:key="index" id="message-{{index}}" class="bubble {{item.role === 'assistant' ? 'assistant' : ''}}"><text>{{item.text}}</text><text class="tiny">{{item.date}}</text></view><view wx:if="{{chatPaused}}" class="notice danger"><text>{{riskNotice}}</text><button class="primary" data-route="booking" bindtap="go">了解专家咨询</button></view></scroll-view>
    <view class="chat-input"><input value="{{chatText}}" maxlength="600" placeholder="说说此刻的感受…" disabled="{{chatPaused}}" bindinput="chatInput" confirm-type="send" bindconfirm="noop"/><button class="primary" size="mini" disabled="{{chatPaused}}" data-action="chat-send" bindtap="act">发送</button></view>
  </view>
  <scroll-view wx:elif="{{route !== 'splash'}}" scroll-y class="page-content">
    <view wx:if="{{route === 'home'}}">
      <view class="welcome"><text class="eyebrow">让笔墨，成为心情的容器</text><text class="greeting">{{greeting}}</text><text class="small">本工具为美育情绪辅助，不构成心理诊断，严重情绪问题请寻求专业帮助</text><image src="/assets/home-mountains.jpg" mode="widthFix" class="welcome-image"/></view>
      <text class="section-title">此刻，从心出发</text><view class="modules"><view class="module primary-module" data-route="test" bindtap="go"><text class="module-glyph">觉</text><text class="module-title">情绪自测</text><text class="tiny">美育觉察与 PHQ-9</text></view><view class="module" data-route="write" bindtap="go"><text class="module-glyph">书</text><text class="module-title">正念书法书写</text><text class="tiny">随息落笔，一笔安然</text></view><view class="module" data-route="paint" bindtap="go"><text class="module-glyph">墨</text><text class="module-title">水墨情绪创作</text><text class="tiny">用颜色与留白表达</text></view><view class="module" data-route="chat" bindtap="go"><text class="module-glyph">伴</text><text class="module-title">AI情绪陪伴对话</text><text class="tiny">听见感受，陪伴表达</text></view><view class="module wide" data-route="booking" bindtap="go"><text class="module-title">线下活动预约 →</text><text class="tiny">团辅与专家预约</text></view></view>
      <text class="section-title">最新线下团辅预告</text><swiper class="activity-swiper" autoplay circular indicator-dots interval="6000"><swiper-item wx:for="{{activities}}" wx:key="id"><view class="event"><text class="tag">活动预告</text><text class="card-title">{{item.title}}</text><text class="small">{{item.time}} · {{item.place}}</text><button size="mini" data-route="booking" bindtap="go">了解与预约 →</button></view></swiper-item></swiper>
    </view>
    <view wx:elif="{{route === 'test'}}"><view class="tools"><button size="mini" class="{{assessmentId === 'awareness' ? 'primary' : ''}}" data-action="assessment" data-id="awareness" bindtap="act">美育觉察</button><button size="mini" class="{{assessmentId === 'phq9' ? 'primary' : ''}}" data-action="assessment" data-id="phq9" bindtap="act">PHQ-9</button></view><text class="eyebrow">{{questionCount}} 题 · {{period}}</text><text class="title block">{{assessmentTitle}}</text><text class="small">{{assessmentDescription}}</text><progress percent="{{answered / questionCount * 100}}" activeColor="#53675B" stroke-width="3"/><view class="row"><text class="tiny">已完成 {{answered}} / {{questionCount}}</text><text class="tag">第 {{questionIndex + 1}} 题</text></view><view class="question"><text class="eyebrow">QUESTION {{questionIndex + 1}}</text><text class="question-title">{{question}}</text><radio-group bindchange="answerChange" class="options"><label wx:for="{{options}}" wx:key="index" class="option"><radio value="{{index}}" checked="{{answers[questionIndex] === index}}" color="#53675B"/><text>{{item}}</text><text class="tiny">{{index}} 分</text></label></radio-group></view><view class="tools"><button data-action="quiz-prev" bindtap="act" disabled="{{questionIndex === 0}}">上一题</button><button class="primary" data-action="quiz-next" bindtap="act">{{questionIndex === questionCount - 1 ? '查看结果' : '下一题'}}</button></view><view class="notice">{{assessmentId === 'phq9' ? 'PHQ-9 为筛查工具，不能仅凭分数作诊断。第 9 题的感受无论总分多少都值得及时寻求支持。' : '答案没有对错。美育觉察结果不用于疾病筛查或诊断。'}}</view></view>
    <view wx:elif="{{route === 'result'}}"><text class="eyebrow">只为觉察，不作定性</text><text class="title block">你的情绪参考</text><block wx:if="{{report}}"><text class="tiny">{{report.date}}</text><view wx:if="{{report.scaleId === 'phq9'}}" class="score-card"><text class="score-number">{{report.score}} / 27</text><text class="small">PHQ-9 总分 · 参考区间 {{report.band}}</text><text class="tiny">分数不能独立确定诊断或安全风险</text></view><canvas wx:else id="radarCanvas" type="2d" class="radar"/><view class="card"><text>{{report.text}}</text></view><view class="notice">{{report.note}}</view><view wx:if="{{report.safetyFlag}}" class="notice danger">{{phqSupport}}</view><button wx:if="{{report.scaleId === 'phq9'}}" data-route="experts" bindtap="go">了解专业支持</button><button class="primary" data-route="write" bindtap="go">去书法书写放松</button><button data-route="paint" bindtap="go">去水墨创作表达</button><button data-route="chat" bindtap="go">AI情绪陪伴聊聊</button><button class="danger-button" data-action="report-delete" bindtap="act">删除这份本地报告</button></block><button wx:else class="primary" data-route="test" bindtap="go">开始自测</button></view>
    <view wx:elif="{{route === 'library' || route === 'admin-works'}}"><view wx:if="{{route === 'admin-works'}}" class="notice danger">只查看主动授权的作品。</view><text class="title block">{{route === 'admin-works' ? '学员授权作品' : '我的情绪作品库'}}</text><text class="small">{{route === 'admin-works' ? '评语仅从美育和艺术表达角度参考，严禁心理诊断。' : '默认私密，主动授权后才出现在导师面板。'}}</text><view wx:if="{{route === 'library'}}" class="tools filters"><button size="mini" data-action="filter" data-id="all" bindtap="act">全部作品</button><button size="mini" data-action="filter" data-id="write" bindtap="act">正念书法</button><button size="mini" data-action="filter" data-id="paint" bindtap="act">水墨画作</button><button size="mini" data-action="filter" data-id="report" bindtap="act">自测报告</button></view><block wx:if="{{filter === 'report' && route === 'library'}}"><view wx:for="{{reports}}" wx:key="id" class="card" data-route="result" data-id="{{item.id}}" bindtap="go"><text class="card-title">{{item.title || '美育觉察报告'}} →</text><text class="tiny">{{item.date}}</text><text class="small">仅作情绪参考，不做诊断</text></view><view wx:if="{{reports.length === 0}}" class="empty">还没有自测报告</view></block><block wx:else><view class="works"><view wx:for="{{works}}" wx:key="id" class="work" data-action="{{route === 'admin-works' ? 'mentor-work' : 'work'}}" data-id="{{item.id}}" bindtap="act"><image src="{{item.image}}" mode="aspectFit"/><view class="work-info"><text class="tag">{{item.emotion}}</text><text class="tiny">{{item.authorized ? '已授权导师' : '仅自己可见'}}</text><text class="tiny">{{item.date}}</text><text class="work-note">{{item.note || item.kind}}</text></view></view></view><view wx:if="{{works.length === 0}}" class="empty">{{route === 'admin-works' ? '目前没有主动授权的作品，私密作品不会显示。' : '还没有作品，去写一笔、画一画吧。'}}</view><view wx:if="{{route === 'library'}}" class="row pager"><button size="mini" data-action="works-prev" bindtap="act">上一页</button><text class="tiny">{{workPage + 1}} / {{totalPages}}</text><button size="mini" data-action="works-next" bindtap="act">下一页</button></view></block></view>
    <view wx:elif="{{route === 'booking'}}"><text class="eyebrow">线下见面，慢慢表达</text><text class="title block">预约服务</text><text class="section-title">线下艺术团辅</text><text class="small">艺术团辅属于美育活动，不等同于心理治疗。</text><view wx:for="{{activities}}" wx:key="id" class="card"><view class="row"><text class="card-title">{{item.title}}</text><text class="tag">余 {{item.remaining}} 名</text></view><text class="small">{{item.time}}
{{item.place}}
{{item.intro}}</text><button class="primary" data-action="book-activity" data-id="{{item.id}}" bindtap="act">预约这场团辅</button></view><text class="section-title">专家一对一咨询预约</text><view class="card"><text class="small">不提供线上实时心理咨询，具体咨询安排请与机构确认。</text><button class="primary" data-route="experts" bindtap="go">查看全部专家 →</button></view></view>
    <view wx:elif="{{route === 'experts' || route === 'admin-experts'}}"><view wx:if="{{route === 'admin-experts'}}" class="notice danger">专家库管理</view><view class="row"><text class="title">{{route === 'experts' ? '心理咨询专家库' : '专家库管理'}}</text><button wx:if="{{route === 'admin-experts'}}" size="mini" class="primary" data-action="new-expert" bindtap="act">新增</button></view><view class="notice">不提供线上实时心理咨询，具体咨询安排请与机构确认。
</view><view wx:for="{{experts}}" wx:key="id" class="card"><view class="expert"><image src="/assets/avatar-{{item.avatar % 2}}.png" class="avatar"/><view><text class="card-title">{{item.name}}</text><text class="tag">{{item.title}}</text><text class="small">{{item.specialty}}</text></view></view><text class="tiny">{{item.slotsText}}</text><view wx:if="{{route === 'admin-experts'}}" class="tools"><button data-action="edit-expert" data-id="{{item.id}}" bindtap="act">编辑</button><button data-action="expert-toggle" data-id="{{item.id}}" bindtap="act">{{item.active ? '停用' : '启用'}}</button></view><button wx:else class="primary" data-action="book-expert" data-id="{{item.id}}" bindtap="act">查看时段与预约</button><text wx:if="{{!item.active}}" class="red-text tiny">已停用</text></view></view>
    <view wx:elif="{{route === 'profile'}}"><text class="eyebrow">温柔收藏每一次感受</text><text class="title block">个人中心</text><view class="profile-card"><text class="profile-glyph">我</text><view><text class="card-title">{{profile.nickname}}</text><text class="tiny">{{profile.id}}</text><text class="small">{{profile.grade}}</text></view></view><view class="stats"><view><text class="stat-number">{{workCount}}</text><text class="tiny">笔墨作品</text></view><view><text class="stat-number">{{reportCount}}</text><text class="tiny">觉察报告</text></view><view><text class="stat-number">{{bookingCount}}</text><text class="tiny">预约记录</text></view></view><view class="menu"><button data-action="profile-edit" bindtap="act">个人基础信息 ›</button><button data-route="library" bindtap="go">我的作品库 ›</button><button data-action="my-reports" bindtap="act">自测报告回看 ›</button><button data-action="my-chats" bindtap="act">AI对话会话管理 ›</button><button data-action="my-bookings" bindtap="act">我的预约记录 ›</button><button data-action="my-messages" bindtap="act">工单留言 ›</button><button data-action="privacy" bindtap="act">隐私设置 ›</button><button data-action="about" bindtap="act">项目介绍与完整免责声明 ›</button><button data-route="experts" bindtap="go">专家库 ›</button><button data-route="admin-risk" bindtap="go">导师工作台 ›</button></view><view class="notice">清除缓存前，请备份重要作品。</view></view>
    <view wx:elif="{{route === 'admin-risk'}}"><text class="eyebrow red-text">导师工作台</text><text class="title block">高危关键词工单队列</text><view class="notice danger">关键词触发仅作关注提示，不等同于专业风险评估。</view><view wx:for="{{cases}}" wx:key="id" class="card risk-card"><view class="row"><text class="tag red">{{item.status}}</text><text class="tiny">{{item.demo ? '预置案例' : '会话触发'}}</text></view><text class="card-title">{{item.userId}}</text><text class="tiny">{{item.date}}</text><text class="small">{{item.last}}</text><view><text wx:for="{{item.tags}}" wx:for-item="riskTag" wx:key="*this" class="tag red">{{riskTag}}</text></view><view class="tools"><button data-action="case" data-id="{{item.id}}" bindtap="act">查看与跟进</button><button data-action="assist" data-id="{{item.id}}" bindtap="act">协助预约</button></view></view></view>
    <view wx:elif="{{route === 'admin-booking'}}"><text class="eyebrow red-text">导师工作台</text><text class="title block">预约工单管理</text><view wx:for="{{bookings}}" wx:key="id" class="card"><view class="row"><text class="tag">{{item.status}}</text><text class="tiny">{{item.kind === 'activity' ? '团辅报名' : '专家预约'}}</text></view><text class="card-title">{{item.title}}</text><text class="small">{{item.name}} · {{item.grade}}
{{item.slot}}
{{item.contact}}
{{item.request}}</text><view class="tools"><button size="mini" data-action="booking-confirm" data-id="{{item.id}}" bindtap="act">确认</button><button size="mini" data-action="booking-done" data-id="{{item.id}}" bindtap="act">完成</button><button size="mini" data-action="booking-cancel" data-id="{{item.id}}" bindtap="act">取消</button></view></view><view wx:if="{{bookings.length === 0}}" class="empty">暂无预约工单</view></view>
    <view wx:if="{{isAdmin}}" class="tools admin-links"><button size="mini" data-route="admin-risk" bindtap="go">高危工单</button><button size="mini" data-route="admin-booking" bindtap="go">预约管理</button><button size="mini" data-route="admin-experts" bindtap="go">专家管理</button><button size="mini" data-route="admin-works" bindtap="go">授权作品</button><button size="mini" data-route="profile" bindtap="go">返回学生端</button></view>
  </scroll-view>
  <text class="footer" wx:if="{{route !== 'splash'}}">书画美育情绪辅助，不提供心理诊断。</text>
  <view wx:if="{{route !== 'splash'}}" class="bottom"><view data-route="home" bindtap="go"><text class="nav-glyph">⌂</text><text>首页</text></view><view data-route="library" bindtap="go"><text class="nav-glyph">藏</text><text>作品库</text></view><view data-route="booking" bindtap="go"><text class="nav-glyph">约</text><text>预约</text></view><view data-route="profile" bindtap="go"><text class="nav-glyph">我</text><text>我的</text></view></view>
  <view wx:if="{{sheet}}" class="overlay" catchtouchmove="noop"><view class="sheet"><view class="sheet-head"><text class="title">{{sheet === 'paper-crop' ? '裁切纸张' : sheet === 'gallery' ? '鉴赏与参考' : sheet === 'save-art' ? '收藏这一刻' : sheet === 'work' ? '笔墨作品' : sheet === 'booking' ? '预约记录' : sheet === 'expert' ? '专家资料' : sheet === 'case' ? '工单跟进' : sheet === 'privacy' ? '隐私设置' : sheet === 'chats' ? 'AI会话管理' : sheet === 'bookings' ? '我的预约记录' : sheet === 'stamp' ? '朱文小印' : sheet === 'receipt' ? '预约回执' : sheet === 'profile' ? '个人信息' : sheet === 'messages' ? '工单留言' : '关于墨润心源'}}</text><button size="mini" bindtap="close">关闭</button></view><scroll-view scroll-y class="sheet-body"><view wx:if="{{sheet === 'gallery'}}"><view wx:for="{{artReferences}}" wx:key="id" class="art-reference"><text class="card-title">{{item.title}}</text><text class="small">{{item.intro}}</text><image wx:if="{{item.image}}" class="reference-image" src="/assets/{{item.image}}" mode="widthFix" data-action="reference-preview" data-id="{{item.image}}" bindtap="act"/><view wx:else class="reference-pending">山水作品图片待补充</view><text class="small">观赏 · {{item.observation}}</text><text class="small">试一试 · {{item.practice}}</text></view><text class="tiny">点按图片可放大查看。关闭后继续创作，笔迹保留。</text></view>

    <view wx:elif="{{sheet === 'paper-crop'}}"><text class="small">拖动四角调整大小，拖动选框移动位置。</text><view class="tools"><button size="mini" data-action="crop-ratio" data-id="full" bindtap="act">整张</button><button size="mini" data-action="crop-ratio" data-id="1" bindtap="act">方形</button><button size="mini" data-action="crop-ratio" data-id="1.5" bindtap="act">横幅</button><button size="mini" data-action="crop-ratio" data-id="0.667" bindtap="act">竖幅</button></view><view class="crop-stage" style="width:{{cropStageWidth}}px;height:{{cropStageHeight}}px"><image src="{{cropPreview}}" mode="scaleToFill"/><view class="crop-selection" style="{{cropStyle}}" data-handle="move" catchtouchstart="cropTouchStart" catchtouchmove="cropTouchMove" catchtouchend="cropTouchEnd" catchtouchcancel="cropTouchEnd"><view wx:for="{{['nw','ne','sw','se']}}" wx:key="*this" class="crop-handle {{item}}" data-handle="{{item}}" catchtouchstart="cropTouchStart" catchtouchmove="cropTouchMove" catchtouchend="cropTouchEnd" catchtouchcancel="cropTouchEnd"><view/></view></view></view><text class="tiny">宽 {{cropW}}%</text><slider min="{{cropMinW}}" max="100" value="{{cropW}}" data-axis="w" bindchanging="cropSlider" bindchange="cropSlider" activeColor="#53675B" block-size="18"/><text class="tiny">高 {{cropH}}%</text><slider min="{{cropMinH}}" max="100" value="{{cropH}}" data-axis="h" bindchanging="cropSlider" bindchange="cropSlider" activeColor="#53675B" block-size="18"/><text class="tiny">纸张比例 {{cropSize}}。选框外的笔迹将被裁去，可用撤销恢复整张纸。</text><button class="primary" data-action="crop-confirm" bindtap="act">确认裁切</button></view>
    <view wx:elif="{{sheet === 'save-art'}}"><text class="field">选择情绪标签</text><picker range="{{moods}}" value="{{selectedMood}}" bindchange="moodChange"><view class="pick">{{moods[selectedMood]}} ▾</view></picker><text class="field">简短心情备注（选填）</text><textarea value="{{form.note}}" data-field="note" bindinput="input" maxlength="300" placeholder="这幅作品让我想到……"/><text class="tiny">作品默认仅自己可见，可在作品库主动授权。</text><button class="primary" data-action="art-confirm" bindtap="act">保存到作品库</button></view>
    <view wx:elif="{{sheet === 'stamp'}}"><text class="small">印章位于长幅纸面右下角，可撤销。</text><view class="tools"><button data-action="stamp-pick" data-id="静心" bindtap="act">静心</button><button data-action="stamp-pick" data-id="安然" bindtap="act">安然</button><button data-action="stamp-pick" data-id="自在" bindtap="act">自在</button></view></view>
    <view wx:elif="{{sheet === 'work'}}"><image class="detail-image" src="{{selectedWork.image}}" mode="aspectFit" data-action="preview-image" bindtap="act"/><text class="tag">{{selectedWork.emotion}}</text><text class="tiny">{{selectedWork.date}}</text><text class="small">{{selectedWork.note || '此刻无言，笔墨已替我表达。'}}</text><view wx:for="{{selectedWork.comments}}" wx:key="index" class="comment">美育评语：{{item.text}}</view><view wx:if="{{mentorView}}"><text class="field">美育评语（严禁心理诊断类文字）</text><textarea data-field="comment" value="{{form.comment}}" bindinput="input" maxlength="300"/><button class="primary" data-action="comment-save" bindtap="act">保存评语</button></view><view wx:else><view class="row"><text class="small">授权导师查看</text><switch checked="{{selectedWork.authorized}}" color="#53675B" bindchange="authorizeChange"/></view><view class="tools"><button data-action="album" bindtap="act">保存相册</button><button class="danger-button" data-action="work-delete" data-id="{{selectedWork.id}}" bindtap="act">删除作品</button></view></view></view>
    <view wx:elif="{{sheet === 'booking'}}"><text class="card-title">{{target.name || target.title}}</text><text class="small">{{target.bio || target.intro}}</text><view wx:if="{{bookingKind === 'expert'}}"><text class="field">可约时段</text><picker range="{{slots}}" value="{{slotIndex}}" bindchange="slotChange"><view class="pick">{{slots.length ? slots[slotIndex] : '时段已约满'}} ▾</view></picker></view><text wx:else class="small">{{target.time}} · {{target.place}}</text><text class="field">称呼（可用化名）</text><input value="{{form.name}}" data-field="name" bindinput="input" maxlength="20"/><text class="field">年级 / 基础信息</text><input value="{{form.grade}}" data-field="grade" bindinput="input" maxlength="20"/><text class="field">联系方式（选填）</text><input value="{{form.contact}}" data-field="contact" bindinput="input" maxlength="50"/><text class="field">预约诉求（选填）</text><textarea value="{{form.request}}" data-field="request" bindinput="input" maxlength="300"/><checkbox-group bindchange="consentChange"><label class="check"><checkbox value="yes" checked="{{form.consent}}" color="#53675B"/>我已核对预约信息。</label></checkbox-group><button class="primary" disabled="{{bookingKind === 'expert' && slots.length === 0}}" data-action="book-confirm" bindtap="act">保存预约记录</button></view>
    <view wx:elif="{{sheet === 'receipt'}}"><text class="receipt-glyph">约</text><text class="card-title">预约记录已保存</text><text class="small">{{receipt.title}}
{{receipt.slot}}
状态：{{receipt.status}}</text><text class="tiny">回执号 {{receipt.id}}
</text><button data-action="my-bookings" bindtap="act">查看我的预约</button></view>
    <view wx:elif="{{sheet === 'profile'}}"><text class="small">可以使用你喜欢的称呼。</text><text class="field">称呼</text><input value="{{form.nickname}}" data-field="nickname" bindinput="input" maxlength="20"/><text class="field">年级</text><input value="{{form.grade}}" data-field="grade" bindinput="input" maxlength="20"/><text class="field">联系方式（选填）</text><input value="{{form.contact}}" data-field="contact" bindinput="input" maxlength="50"/><button class="primary" data-action="profile-save" bindtap="act">保存</button></view>
    <view wx:elif="{{sheet === 'chats'}}"><view wx:for="{{sessions}}" wx:key="id" class="list-item"><text>{{item.date}}</text><text class="tag {{item.paused ? 'red' : ''}}">{{item.paused ? '已暂停' : '对话记录'}}</text><text class="tiny">{{item.count}} 条消息</text><view class="tools"><button data-action="open-chat" data-id="{{item.id}}" bindtap="act">查看</button><button data-action="delete-chat" data-id="{{item.id}}" bindtap="act">删除</button></view></view><text wx:if="{{sessions.length === 0}}" class="small">还没有会话</text></view>
    <view wx:elif="{{sheet === 'bookings'}}"><view wx:for="{{ownBookings}}" wx:key="id" class="list-item"><text class="tag">{{item.status}}</text><text class="card-title">{{item.title}}</text><text class="small">{{item.slot}}</text><text class="tiny">{{item.id}}</text><button wx:if="{{item.status !== '已取消' && item.status !== '已完成'}}" data-action="booking-cancel" data-id="{{item.id}}" bindtap="act">取消预约</button></view><text wx:if="{{ownBookings.length === 0}}" class="small">暂无预约记录</text></view>
    <view wx:elif="{{sheet === 'messages'}}"><view wx:for="{{ownCases}}" wx:key="id" class="list-item"><text class="tag red">{{item.status}}</text><text class="tiny">{{item.date}}</text><text wx:if="{{item.notes.length === 0}}" class="small">暂无留言。</text><view wx:for="{{item.notes}}" wx:for-item="note" wx:key="index" class="comment">{{note.text}}</view></view><text wx:if="{{ownCases.length === 0}}" class="small">暂无工单留言</text></view>
    <view wx:elif="{{sheet === 'privacy'}}"><view class="row"><text class="small">新作品默认仅自己可见</text><switch checked="{{privacy}}" color="#53675B" bindchange="privacyChange"/></view><view class="notice">关闭后新保存作品默认授权导师，已有作品不变，仍可逐幅撤回。</view><button class="danger-button" data-action="reset" bindtap="act">清空 V2 数据</button></view>
    <view wx:elif="{{sheet === 'case'}}"><text class="tag red">{{selectedCase.status}}</text><text class="small">用户 {{selectedCase.userId}}</text><text class="tiny">{{selectedCase.date}}</text><view class="notice"><view wx:for="{{selectedCase.transcript}}" wx:key="index"><text class="small">{{item.role === 'user' ? '用户' : '笔墨陪伴'}}：{{item.text}}</text></view></view><view wx:for="{{selectedCase.notes}}" wx:key="index" class="comment">{{item.text}}</view><text class="field">站内留言</text><textarea data-field="caseNote" value="{{form.caseNote}}" bindinput="input" maxlength="400"/><button data-action="case-note" bindtap="act">保存留言</button><view class="tools"><button data-action="case-progress" data-id="{{selectedCase.id}}" bindtap="act">跟进中</button><button data-action="case-done" data-id="{{selectedCase.id}}" bindtap="act">处理完成</button><button data-action="assist" data-id="{{selectedCase.id}}" bindtap="act">协助预约</button></view></view>
    <view wx:elif="{{sheet === 'expert'}}"><text class="small"></text><text class="field">姓名</text><input value="{{form.name}}" data-field="name" bindinput="input" maxlength="30"/><text class="field">身份标签</text><input value="{{form.title}}" data-field="title" bindinput="input" maxlength="80"/><text class="field">擅长方向</text><input value="{{form.specialty}}" data-field="specialty" bindinput="input" maxlength="100"/><text class="field">资料说明</text><textarea value="{{form.bio}}" data-field="bio" bindinput="input" maxlength="400"/><text class="field">可约时段（每行一个）</text><textarea value="{{form.slots}}" data-field="slots" bindinput="input"/><view class="row"><text>启用</text><switch checked="{{expertActive}}" bindchange="expertActiveChange" color="#53675B"/></view><button class="primary" data-action="expert-save" bindtap="act">保存专家资料</button></view>
    <view wx:else><text class="card-title">以笔墨润心境，以美育疗情绪</text><text class="small">本项目是线下初高中书画艺术疗愈团体辅导的线上配套 Demo，以传统书画美育与表达性艺术理念，帮助青少年觉察感受、练习表达。</text><view class="notice danger">{{disclaimer}}</view><text class="small">美育觉察问卷为自编问题，未经量表信效度验证；PHQ-9 为独立筛查工具，不作心理诊断与风险定性。关键词规则可能误报或漏报，不代表专业评估。

本项目为大学生竞赛作品。人物、活动与排班为演示资料；实际服务请通过机构正规渠道确认。对话采用预设问答。记录保存在当前设备，清除缓存前请备份重要作品。

未成年人遇到强烈痛苦时，请向可信任的成年人或专业人员求助。

第十四届全国大学生数字媒体科技作品及创意竞赛参赛演示，非商用。</text></view>
  </scroll-view></view></view>
<view wx:if="{{inkPresentation}}" class="ink-screen"><view class="ink-screen-head"><view><text class="eyebrow">墨润心源</text><text class="title block">落笔成境</text></view><button size="mini" data-action="ink-library" bindtap="act">跳过动画</button></view><canvas id="inkRevealCanvas" type="2d" class="ink-scene-canvas"/><view class="ink-screen-bottom"><text class="ink-caption">{{inkCaption}}</text><text class="tiny">你的作品已收藏</text><view class="tools"><button wx:if="{{inkComplete}}" size="mini" data-action="ink-replay" bindtap="act">再赏一遍</button><button size="mini" data-action="ink-continue" bindtap="act">继续书写</button><button size="mini" class="primary" data-action="ink-library" bindtap="act">查看作品 →</button></view></view></view>
</view>
